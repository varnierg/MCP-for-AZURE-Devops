      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "The work item ID"
          },
          "fields": {
            "type": "object",
            "description": "Key-value pairs of all work item fields"
          }
        },
        "required": [
          "id",
          "fields"
        ]
      },
      "annotations": {
        "title": "Get Work Item",
        "readOnlyHint": true,
        "idempotentHint": true
      }
    },
