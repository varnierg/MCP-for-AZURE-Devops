        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "The newly created work item ID"
          },
          "fields": {
            "type": "object",
            "description": "Key-value pairs of the work item fields"
          }
        },
        "required": [
