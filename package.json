{
  "name": "mcp-azure-devops",
  "version": "1.0.0",
  "description": "Azure DevOps Model Context Protocol Server",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --external:axios --external:dotenv && node copy-assets.js",
    "prepare": "tsc && esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --external:axios --external:dotenv && node copy-assets.js",
    "start": "node dist/index.js",
    "setup": "ts-node src/setup.ts",
    "test": "ts-node src/test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "esbuild": "^0.20.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
